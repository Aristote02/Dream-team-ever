<!doctype html>
<html lang="en">
  <body style="margin:0;padding:0;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;color:#111827;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f6f7fb;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e5e7eb;">
            <tr>
              <td style="padding:24px;text-align:center;background:#fff7ed;border-bottom:1px solid #ffedd5;">
                {{#logoSvgDataUri}}
                <img src="{{{logoSvgDataUri}}}" alt="Dream Team Ever" width="72" height="72" style="display:block;margin:0 auto 12px auto;" />
                {{/logoSvgDataUri}}
                <h1 style="margin:0;font-size:20px;line-height:1.3;color:#111827;">New Login Detected</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:24px;">
                <p style="margin:0 0 12px 0;font-size:15px;line-height:1.6;">Hi {{recipientName}},</p>
                <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;">
                  We noticed a new login to your Dream Team Ever account.
                </p>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;">
                  <tr>
                    <td style="padding:14px 16px;font-size:14px;line-height:1.6;">
                      <strong>Time (UTC):</strong> {{loggedInAtUtc}}<br />
                      <strong>IP Address:</strong> {{ipAddress}}<br />
                      <strong>Device:</strong> {{userAgent}}
                    </td>
                  </tr>
                </table>
                <p style="margin:16px 0 0 0;font-size:14px;line-height:1.6;color:#374151;">
                  If this was you, you can ignore this email. If not, please reset your password immediately.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
