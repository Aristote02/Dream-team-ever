<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- Satellite assemblies from *.culture.resx without legacy .NET Framework al.exe (fixes MSB3086 when WinSDK/NETFX SDK tools are missing). -->
    <GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LinqKit.Core" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.Swagger" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DreamTeamEver.Application\DreamTeamEver.Application.csproj"/>
        <ProjectReference Include="..\DreamTeamEver.Infrastructure\DreamTeamEver.Infrastructure.csproj"/>
        <ProjectReference Include="..\..\..\Aspire\DreamTeamEver.ServiceDefaults\DreamTeamEver.ServiceDefaults.csproj"/>
    </ItemGroup>

</Project>
